{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-ledger.local/schemas/claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "statement", "kind", "state", "authority", "scope", "universal", "severity", "relationships", "evidence", "history"],
  "properties": {
    "id": { "type": "string", "pattern": "^CLM-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "statement": { "type": "string", "minLength": 8 },
    "detail": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["invariant", "fact", "intent", "hazard", "conflict"] },
    "state": { "enum": ["proposed", "accepted", "verified", "enforced", "contested", "superseded"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["user", "instruction", "implementation", "document", "session"] },
        "source": { "type": "string", "minLength": 1 },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "paths", "entities"],
      "properties": {
        "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "entities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "universal": { "type": "boolean" },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "singleValueKey": { "type": "string", "minLength": 1 },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": { "enum": ["conflictsWith", "supersedes", "dependsOn", "relatedTo"] },
          "target": { "type": "string", "pattern": "^CLM-[a-z0-9-]+$" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "at", "actor", "source"],
        "properties": {
          "from": { "type": ["string", "null"] },
          "to": { "enum": ["proposed", "accepted", "verified", "enforced", "contested", "superseded"] },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "normalizedContentHash", "displayLine", "verifiedAtCommit", "verification"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["symbol", "heading", "jsonPath", "yamlPath", "file", "excerpt"] },
            "value": { "type": "string" }
          }
        },
        "normalizedContentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "displayLine": { "type": "integer", "minimum": 1 },
        "verifiedAtCommit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["test", "inspection", "user"] },
            "command": { "type": "string" },
            "test": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
